# Replit provides DATABASE_URL for this workspace automatically.
# For local development, provide your own PostgreSQL connection string.
DATABASE_URL=postgresql://user:password@localhost:5432/command_post

# Optional hosted-provider credentials. Configure only the providers you use.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=

# Required before enabling Command Post's public API routes. Generate distinct
# high-entropy values and store them in your deployment secret manager.
COMMAND_POST_OPERATOR_API_KEY=
COMMAND_POST_GATEWAY_API_KEY=

# Per-principal limits applied before requests reach a provider adapter.
GATEWAY_REQUESTS_PER_MINUTE=60
GATEWAY_REQUESTS_PER_DAY=1000

# Optional public URL for a remote Ollama server.
# Do not use localhost when the API is running in Replit.
OLLAMA_BASE_URL=https://ollama.example.com

# Supplied by the managed artifact workflows; normally not needed in .env.
PORT=8080
BASE_PATH=/